# Reference only: main.py reads process environment variables; it does not auto-load this file.
# Keep actual secrets in your process environment or deployment secret store.

# Server
HOST=127.0.0.1
PORT=8000
CHAT_DB_PATH=chat_memory.db
CREATE_MIGRATION_BACKUPS=true
MIGRATION_BACKUP_DIR=chat_memory_backups
CREATE_PERIODIC_BACKUPS=true
PERIODIC_BACKUP_DIR=chat_memory_backups
PERIODIC_BACKUP_INTERVAL_SECONDS=86400
PERIODIC_BACKUP_RETENTION_COUNT=7
SQLITE_BUSY_TIMEOUT_MS=10000
PUBLIC_BASE_URL=
TRUSTED_HOSTS=
NGROK_AUTHTOKEN=

# Owner identity: both values must match the account registration.
OWNER_USERNAME=admin
OWNER_EMAIL=admin@example.com

# Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-coder-v2:16B
OLLAMA_CONTEXT_SIZE=32768
# Function analysis grows its context per job; set false for a fixed-window comparison.
OLLAMA_ADAPTIVE_ANALYSIS_CONTEXT=true
OLLAMA_ANALYSIS_CONTEXT_MIN=8192
OLLAMA_ANALYSIS_CONTEXT_MAX=65536
OLLAMA_MAX_OUTPUT_TOKENS=4096
OLLAMA_TEMPERATURE=0.2
OLLAMA_REPEAT_PENALTY=1.15
OLLAMA_SOCKET_TIMEOUT=1800
# Wall-clock limit for each function-analysis model generation.
FUNCTION_ANALYSIS_REQUEST_TIMEOUT=300
OLLAMA_GPT_OSS_REASONING=low

# Readiness probe timeout and result-cache lifetime
READINESS_OLLAMA_TIMEOUT_SECONDS=2
READINESS_CACHE_SECONDS=5

# Queue and per-user resource limits
JOB_QUEUE_CAPACITY=20
MAX_ACTIVE_JOBS_PER_USER=3
MAX_PENDING_INPUT_CHARS_PER_USER=3000000

# Project upload safety limits
PROJECT_UPLOAD_MAX_ARCHIVE_BYTES=25000000
PROJECT_UPLOAD_MAX_EXPANDED_BYTES=100000000
PROJECT_UPLOAD_MAX_FILE_BYTES=5000000
PROJECT_UPLOAD_MAX_FILES=2000
PROJECT_UPLOAD_MAX_COMPRESSION_RATIO=100

# Conversation and analysis limits
MAX_HISTORY_MESSAGES=50
CHAT_HISTORY_PAGE_SIZE=20
CHAT_LIST_PAGE_SIZE=50
ADMIN_USER_PAGE_SIZE=50
MAX_MESSAGE_CHARS=1500000
DIRECT_MESSAGE_CHARS=20000
LARGE_CHUNK_CHARS=20000
LARGE_CHUNK_OVERLAP_CHARS=800
LARGE_CHUNK_SUMMARY_TOKENS=650
CONSOLIDATION_CHUNK_CHARS=24000
CONSOLIDATION_MAX_CHARS=70000
LARGE_REQUEST_CONTEXT_CHARS=1500
LARGE_VERIFICATION_TOKENS=4096
EVIDENCE_REPAIR_SOURCE_CHARS=24000
SOURCE_INVENTORY_MAX_CHARS=16000
FUNCTION_ANALYSIS_MAX_SOURCE_CHARS=40000
FUNCTION_ANALYSIS_CHUNK_CHARS=20000
FUNCTION_ANALYSIS_MAX_OUTPUT_TOKENS=8192
FUNCTION_ANALYSIS_ADAPTIVE_OUTPUT=true
FUNCTION_ANALYSIS_CONTEXT_CHARS=20000
FUNCTION_ANALYSIS_BATCH_SIZE=8
FUNCTION_ANALYSIS_BATCH_MAX_CHARS=32000
FUNCTION_ANALYSIS_BATCH_MAX_OUTPUT_TOKENS=16384
FUNCTION_ANALYSIS_CACHE_RETENTION_DAYS=90
FUNCTION_ANALYSIS_CACHE_MAX_ROWS_PER_USER=5000
HISTORY_CONTEXT_MESSAGE_CHARS=60000
MODEL_INPUT_CHAR_BUDGET=90000

# SMTP. PUBLIC_BASE_URL is also required when email is enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# NTFY push alerts for ERROR/CRITICAL console records. Empty NTFY_TOPIC disables them.
NTFY_SERVER_URL=https://ntfy.sh
NTFY_TOPIC=your-private-topic-name
# Optional bearer token for a protected topic; keep the real token out of this file.
NTFY_ACCESS_TOKEN=
NTFY_TIMEOUT_SECONDS=5
NTFY_DEDUP_SECONDS=60
NTFY_QUEUE_CAPACITY=100

# Registration, login, reset, and session controls
VERIFICATION_MINUTES=30
REGISTRATION_RESEND_SECONDS=60
REGISTRATION_IP_WINDOW_SECONDS=3600
REGISTRATION_MAX_REQUESTS_PER_IP=10
AUTH_EMAIL_RESPONSE_FLOOR_SECONDS=0.25
PASSWORD_RESET_MINUTES=30
PASSWORD_RESET_RESEND_SECONDS=60
PASSWORD_RESET_IP_WINDOW_SECONDS=3600
PASSWORD_RESET_MAX_REQUESTS_PER_IP=10
LOGIN_ATTEMPT_COOLDOWN_SECONDS=5
LOGIN_MAX_FAILED_ATTEMPTS=3
LOGIN_LOCKOUT_SECONDS=300
SESSION_DAYS=7
MAX_SESSIONS_PER_USER=10
ADMIN_AUDIT_RETENTION_DAYS=365
TERMINAL_JOB_PAYLOAD_RETENTION_DAYS=7
SECURITY_CLEANUP_INTERVAL_SECONDS=3600

# Optional override. Leave unset to use the built-in grounded-analysis prompt.
# SYSTEM_PROMPT=
